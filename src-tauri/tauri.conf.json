{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piano",
  "identifier": "io.github.danielnoam.piano",
  "version": "0.0.0",
  "build": {
    "frontendDist": "../www-desktop",
    "beforeBuildCommand": "node tools/build-www.js www-desktop --desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Piano",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#F6F5F2",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Piano practice with your own lessons",
    "homepage": "https://github.com/danielnoam/piano",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
